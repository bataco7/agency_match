generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DiagnosisLog {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  duration_ms Int
  top_agency String
  version    String
  match_map  Json
}
